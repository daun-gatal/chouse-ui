{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "UTC",
  "baseBranches": ["preview"],
  "automerge": false,
  "rangeStrategy": "bump",
  "osvVulnerabilityAlerts": true,
  "vulnerabilityAlerts": {
    "labels": ["security"],
    "schedule": ["at any time"]
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": ["before 6am on monday"]
  },
  "packageRules": [
    {
      "description": "Group routine non-major bumps to keep PR noise down.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major dependencies"
    },
    {
      "description": "Keep Docker base images digest-pinned (Dockerfile + compose).",
      "matchManagers": ["dockerfile", "docker-compose"],
      "pinDigests": true
    },
    {
      "description": "Group Go module bumps for the chouse CLI.",
      "matchManagers": ["gomod"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "go non-major dependencies"
    },
    {
      "description": "Security fixes bypass grouping and the schedule.",
      "matchCategories": ["security"],
      "groupName": null,
      "schedule": ["at any time"],
      "labels": ["security"]
    }
  ]
}
